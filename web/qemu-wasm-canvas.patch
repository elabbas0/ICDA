diff --git a/include/glib-compat.h b/include/glib-compat.h
index 43a5629..affddcd 100644
--- a/include/glib-compat.h
+++ b/include/glib-compat.h
@@ -151,4 +151,31 @@ qemu_g_test_slow(void)
 #define G_NORETURN G_GNUC_NORETURN
 #endif
 
+#ifdef __EMSCRIPTEN__
+/*
+ * glib calls a GCompareFunc through a GCompareDataFunc pointer with an extra
+ * argument.  Native ABIs tolerate that; WebAssembly traps on the signature
+ * mismatch.  Route every two-argument comparator through a trampoline.
+ */
+static inline gint qemu_wasm_cmp_tramp(gconstpointer a, gconstpointer b,
+                                       gpointer f)
+{
+    return ((GCompareFunc)f)(a, b);
+}
+#define g_slist_sort(l, f) \
+    g_slist_sort_with_data((l), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_list_sort(l, f) \
+    g_list_sort_with_data((l), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_slist_insert_sorted(l, d, f) \
+    g_slist_insert_sorted_with_data((l), (d), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_list_insert_sorted(l, d, f) \
+    g_list_insert_sorted_with_data((l), (d), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_array_sort(a, f) \
+    g_array_sort_with_data((a), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_ptr_array_sort(a, f) \
+    g_ptr_array_sort_with_data((a), qemu_wasm_cmp_tramp, (gpointer)(f))
+#define g_tree_new(f) \
+    g_tree_new_with_data(qemu_wasm_cmp_tramp, (gpointer)(f))
+#endif
+
 #endif
