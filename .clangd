# ICDA clangd project config.
#
# The tree is a freestanding x86-64 kernel plus an SSE2 userspace GUI stack
# (see Makefile: CFLAGS vs USR_CFLAGS). Exact per-file flags live in
# compile_commands.json at the project root, generated by:
#
#   scripts\gen-compile-commands.ps1   (Windows, Docker backend)
#
# Re-run the generator after the Makefile gains/removes translation units.
# compile_commands.json itself is machine-local (absolute paths) and stays
# out of version control; this file is shared.
#
# NOTE: no `CompileFlags.CompilationDatabase` is set on purpose. A relative
# path there is resolved against each source file's directory and breaks
# database discovery; the root compile_commands.json is found automatically
# by walking up from the source file.
Index:
  Background: Build
  StandardLibrary: No

Hover:
  ShowAKA: Yes

# Freestanding code has no hosted-libc assumptions; keep clangd from
# "fixing" includes toward the host standard library.
Diagnostics:
  MissingIncludes: Strict
